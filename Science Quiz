import java.util.ArrayList;
import java.util.Collections;
import java.util.List;
import java.util.Scanner;

/**
 * A simple Java console-based multiple-choice science quiz.
 * - Accepts questions and answers at runtime
 * - Randomly selects a subset of questions
 * - Uses if/else for scoring
 * - Allows repeating the quiz
 */
public class ScienceQuiz {

    // Question class to store question text, options, and correct answer
    static class Question {
        String questionText;
        String[] options;
        char correctOption; // 'A', 'B', 'C', 'D'

        Question(String questionText, String[] options, char correctOption) {
            this.questionText = questionText;
            this.options = options;
            this.correctOption = Character.toUpperCase(correctOption);
        }
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        List<Question> questionBank = new ArrayList<>();

        System.out.println("=== Science Quiz Setup ===");
        System.out.print("How many questions do you want to enter? ");
        int totalQuestions = getValidInt(scanner);

        // Input questions from user
        for (int i = 0; i < totalQuestions; i++) {
            System.out.println("\nEnter question " + (i + 1) + ":");
            System.out.print("Question text: ");
            String qText = scanner.nextLine();

            String[] options = new String[4];
            char[] labels = {'A', 'B', 'C', 'D'};
            for (int j = 0; j < 4; j++) {
                System.out.print("Option " + labels[j] + ": ");
                options[j] = scanner.nextLine();
            }

            char correct;
            while (true) {
                System.out.print("Enter correct option (A/B/C/D): ");
                String input = scanner.nextLine().trim().toUpperCase();
                if (input.matches("[ABCD]")) {
                    correct = input.charAt(0);
                    break;
                } else {
                    System.out.println("Invalid choice. Please enter A, B, C, or D.");
                }
            }

            questionBank.add(new Question(qText, options, correct));
        }

        // Quiz loop
        boolean playAgain;
        do {
            System.out.print("\nHow many questions should the quiz have? ");
            int quizSize = getValidInt(scanner);
            if (quizSize > questionBank.size()) {
                quizSize = questionBank.size();
                System.out.println("Only " + quizSize + " questions available.");
            }

            // Randomize and select subset
            Collections.shuffle(questionBank);
            List<Question> quizQuestions = questionBank.subList(0, quizSize);

            int score = 0;
            System.out.println("\n=== Starting the Quiz ===");
            for (int i = 0; i < quizQuestions.size(); i++) {
                Question q = quizQuestions.get(i);
                System.out.println("\nQ" + (i + 1) + ": " + q.questionText);
                char[] labels = {'A', 'B', 'C', 'D'};
                for (int j = 0; j < 4; j++) {
                    System.out.println(labels[j] + ") " + q.options[j]);
                }

                System.out.print("Your answer: ");
                String answer = scanner.nextLine().trim().toUpperCase();

                if (answer.length() == 1 && "ABCD".contains(answer)) {
                    if (answer.charAt(0) == q.correctOption) {
                        System.out.println("✅ Correct!");
                        score++;
                    } else {
                        System.out.println("❌ Wrong! Correct answer: " + q.correctOption);
                    }
                } else {
                    System.out.println("❌ Invalid input. Question skipped.");
                }
            }

            System.out.println("\n=== Quiz Finished ===");
            System.out.println("Your score: " + score + "/" + quizQuestions.size());

            // Ask to play again
            System.out.print("Do you want to play again? (yes/no): ");
            playAgain = scanner.nextLine().trim().equalsIgnoreCase("yes");

        } while (playAgain);

        System.out.println("Thanks for playing!");
        scanner.close();
    }

    // Helper method to safely get an integer
    private static int getValidInt(Scanner scanner) {
        while (true) {
            try {
                int num = Integer.parseInt(scanner.nextLine().trim());
                if (num > 0) return num;
                System.out.print("Enter a positive number: ");
            } catch (NumberFormatException e) {
                System.out.print("Invalid number. Try again: ");
            }
        }
    }
}
